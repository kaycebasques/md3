load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "chromium",
    srcs = select({
        "@bazel_tools//src/conditions:linux_x86_64": [
            "@playwright_chromium_linux_x64//:files",
        ],
    }),
)

py_library(
    name = "harness",
    srcs = ["harness.py"],
    imports = ["."],
    deps = [
        "@deps//sphinx",
    ],
)

py_test(
    name = "console_test",
    srcs = ["console_test.py"],
    data = [":chromium"],
    deps = [
        ":harness",
        "//md3",
        "@deps//playwright",
    ],
)

py_test(
    name = "layout_test",
    srcs = ["layout_test.py"],
    deps = [
        ":harness",
        "//md3",
    ],
)

py_test(
    name = "tabs_test",
    srcs = ["tabs_test.py"],
    data = [":chromium"],
    deps = [
        ":harness",
        "//md3",
        "@deps//playwright",
    ],
)

py_test(
    name = "tokens_test",
    srcs = ["tokens_test.py"],
    data = glob(["*_test.py"]) + [
        ":chromium",
        "//docs",
    ],
    deps = [
        ":harness",
        "//md3",
        "@deps//playwright",
    ],
)

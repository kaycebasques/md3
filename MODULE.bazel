module(
    name = "md3",
    version = "0.0.0",
)

bazel_dep(name = "rules_python", version = "1.9.1")
bazel_dep(name = "sphinxdocs", version = "2.2.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "deps",
    python_version = "3.12",
    requirements_lock = "//:deps.txt",
)
use_repo(pip, "deps")

uv = use_extension("@rules_python//python/uv:uv.bzl", "uv", dev_dependency = True)
uv.configure()

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

http_archive(
    name = "playwright_chromium_linux_x64",
    build_file_content = """
filegroup(
    name = "files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "43fd31766c7533a02dda2ded5ad50c2f861cd5400be7509c0abad71129f79d79",
    strip_prefix = "chrome-linux64",
    urls = [
        "https://cdn.playwright.dev/builds/cft/156.0.8078.4/linux64/chrome-linux64.zip",
    ],
)

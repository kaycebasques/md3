module(
    name = "md3",
    version = "0.0.0",
)

bazel_dep(name = "rules_python", version = "1.9.1")
bazel_dep(name = "sphinxdocs", version = "2.2.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "deps",
    python_version = "3.12",
    requirements_lock = "//:deps.txt",
)
use_repo(pip, "deps")

uv = use_extension("@rules_python//python/uv:uv.bzl", "uv", dev_dependency = True)
uv.configure()
